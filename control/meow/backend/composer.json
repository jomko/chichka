{
  "name": "chichka/meow-api",
  "description": "Private MEOW API",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "google/apiclient": "^2.18",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Meow\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public router.php",
    "test": "php tests/smoke.php"
  },
  "config": {
    "sort-packages": true
  }
}
