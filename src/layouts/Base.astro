---
import '../styles/global.css';
import '../styles/site-header.css';
import { ClientRouter } from 'astro:transitions';
import {t,base} from '../data/projects.js';
const {lang='en',title='Marichka Chichkova',description,image='/assets/social/og.png'}=Astro.props;
const prefix=base(lang);
const current=Astro.url.pathname;
const switchHref=lang==='en'?'/uk'+(current==='/'?'':current):current.replace(/^\/uk/,'')||'/';
const links=[['projects',prefix+'/projects/'],['about',prefix+'/about/'],['contact',prefix+'/contact/']];
const site=Astro.site; // Omit absolute SEO URLs rather than publish localhost canonicals.
const canonical=site ? new URL(current,site).href : null;
const alternate=site ? new URL(switchHref,site).href : null;
const enPath=lang==='en'?current:switchHref;
const english=site ? new URL(enPath,site).href : null;
const shareImage=site ? new URL(image,site).href : null;
const fullTitle=title==='Marichka Chichkova'?title:`${title} — Marichka Chichkova`;
const summary=description||t(lang,'intro');
---
<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
<head>
<meta charset="utf-8"/>
<script is:inline>
if(!window.__chDocumentBooted){
 window.__chDocumentBooted=true;
 if(['/', '/uk', '/uk/'].includes(location.pathname)){
  document.documentElement.classList.add('ch-initial-loading');
  // Fail open if the bundle or image never becomes ready.
  setTimeout(()=>document.documentElement.classList.remove('ch-initial-loading','ch-initial-revealing'),6500);
 }
}
</script>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f5f1eb"/>
<meta name="description" content={summary}/>
<title>{fullTitle}</title>
{canonical&&<link rel="canonical" href={canonical}/>}
{canonical&&<link rel="alternate" hreflang={lang} href={canonical}/>}
{alternate&&<link rel="alternate" hreflang={lang==='en'?'uk':'en'} href={alternate}/>}
{english&&<link rel="alternate" hreflang="x-default" href={english}/>}
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Marichka Chichkova"/>
<meta property="og:locale" content={lang==='uk'?'uk_UA':'en_US'}/>
<meta property="og:title" content={fullTitle}/>
<meta property="og:description" content={summary}/>
{canonical&&<meta property="og:url" content={canonical}/>}
{shareImage&&<meta property="og:image" content={shareImage}/>}
{shareImage&&<meta property="og:image:width" content="1200"/>}
{shareImage&&<meta property="og:image:height" content="630"/>}
{shareImage&&<meta property="og:image:alt" content="Marichka Chichkova — Independent artist & cultural manager"/>}
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={summary}/>
{shareImage&&<meta name="twitter:image" content={shareImage}/>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<ClientRouter fallback="swap" />

</head>
<body>
<div id="ch-editorial-cut" aria-hidden="true"><span>MARICHKA <i>CHICHKOVA</i><b>↗</b></span></div>
<a class="skip-link" href="#content">{lang==='en'?'Skip to content':'Перейти до вмісту'}</a>
<header class="header"><div class="header-inner">
<div class="site-languages" aria-label={lang==='en'?'Language':'Мова'}>
<a href="/" hreflang="en" aria-current={lang==='en'?'page':undefined}>EN</a>
<span aria-hidden="true">/</span>
<a href={lang==='uk'?current:'/uk'+(current==='/'?'':current)} hreflang="uk" aria-current={lang==='uk'?'page':undefined}>UA</a>
</div>
<a class="wordmark" href={prefix+'/'}>Marichka Chichkova</a>
<nav class="navigation" aria-label={lang==='en'?'Main navigation':'Головна навігація'}>
{links.map(([key,url])=><a href={url} aria-current={current===url?'page':undefined}>{t(lang,key)}</a>)}
</nav></div></header>
<main id="content"><slot/></main>
<footer class="footer"><div class="wrap"><span>© {new Date().getFullYear()} Marichka Chichkova</span><span>Independent artist · Cultural manager · Lviv, Ukraine</span></div></footer>
<script is:inline>
(function(){
 const typeSelector='.section .display, .section .large-copy, .project-card h3, .project-card p, .detail-grid, .contact-links, .ch-discipline h2, .ch-discipline .ch-detail, .ch-work__header, .ch-work__caption, .ch-work__statement, .ch-about__content, .ch-collaboration__center, .ch-collaboration__footer';
 const photoSelector='.project-card figure, .detail-hero, .about-portrait, .residency-landscape, .ch-discipline .ch-preview, .ch-work__image';
 let observer;
 function init(){
  observer?.disconnect();
  if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  observer=new IntersectionObserver(entries=>{
   for(const entry of entries){
    if(!entry.isIntersecting)continue;
    entry.target.classList.add('scroll-revealed');
    observer.unobserve(entry.target);
   }
  },{threshold:0,rootMargin:'0px 0px -35px 0px'});
  const items=[
   ...Array.from(document.querySelectorAll(typeSelector),el=>[el,'type']),
   ...Array.from(document.querySelectorAll(photoSelector),el=>[el,'photo'])
  ];
  for(const [el,kind] of items){
   if(el.classList.contains('scroll-revealed'))continue;
   el.dataset.cut=kind;
   if(el.getBoundingClientRect().top<innerHeight-25){
    el.classList.remove('scroll-reveal');
    continue;
   }
   el.classList.add('scroll-reveal');
   observer.observe(el);
  }
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
 else init();
 document.addEventListener('astro:page-load',init);
})();
</script>
<script is:inline>
(function(){
 if(window.__chHeaderScrollInit)return;
 window.__chHeaderScrollInit=true;
 const update=()=>{
  const header=document.querySelector('.header');
  const hero=document.querySelector('.ch-home .ch-hero');
  if(!header)return;
  header.classList.toggle('is-scrolled',!!hero && hero.getBoundingClientRect().bottom<=header.getBoundingClientRect().height);
 };
 window.addEventListener('scroll',update,{passive:true});
 window.addEventListener('resize',update,{passive:true});
 document.addEventListener('astro:page-load',update);
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',update,{once:true});
 update();
})();
</script>
<script>import '../scripts/home-motion.ts';</script>
<script>import '../scripts/project-transition.ts';</script>
<style is:global>
.ch-transition-stage{position:fixed;z-index:2147483647;pointer-events:none;overflow:hidden;background:#111;box-sizing:border-box;will-change:left,top,width,height}
.ch-transition-stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
#ch-editorial-cut{position:fixed;inset:0;z-index:2147483646;background:#111;color:#f5f5f2;visibility:hidden;pointer-events:none;display:grid;place-items:center;clip-path:inset(0 100% 0 0)}
#ch-editorial-cut[data-mode=menu]{background:#f5f5f2;color:#111}
#ch-editorial-cut[data-mode=menu] span{font:800 clamp(52px,12vw,190px)/.9 Arial,Helvetica,sans-serif;letter-spacing:-.08em;text-transform:uppercase}
#ch-editorial-cut span{font:800 clamp(33px,7.5vw,115px)/.93 Arial,Helvetica,sans-serif;letter-spacing:-.075em;padding:24px}
#ch-editorial-cut i{font:400 .93em Georgia,serif;letter-spacing:-.065em}
#ch-editorial-cut b{font:400 .5em Arial,sans-serif;color:#e34234;vertical-align:top;margin-left:.2em}
@media(prefers-reduced-motion:reduce){#ch-editorial-cut{display:none}}
/* No competing Astro page snapshot motion during the custom photographic transition. */
::view-transition-old(root),::view-transition-new(root){animation:none!important}
</style>
</body></html>
