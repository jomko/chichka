---
import '../styles/global.css';
import '../styles/site-header.css';
import { ClientRouter } from 'astro:transitions';
import {t,base} from '../data/projects.js';
const {lang='en',title='Marichka Chichkova',description,image='/assets/social/og.png'}=Astro.props;
const prefix=base(lang);
const current=Astro.url.pathname;
const switchHref=lang==='en'?'/uk'+(current==='/'?'':current):current.replace(/^\/uk/,'')||'/';
const links=[['projects',prefix+'/projects/'],['about',prefix+'/about/'],['contact',prefix+'/contact/']];
const site=Astro.site; // Omit absolute SEO URLs rather than publish localhost canonicals.
const canonical=site ? new URL(current,site).href : null;
const alternate=site ? new URL(switchHref,site).href : null;
const enPath=lang==='en'?current:switchHref;
const english=site ? new URL(enPath,site).href : null;
const shareImage=site ? new URL(image,site).href : null;
const fullTitle=title==='Marichka Chichkova'?title:`${title} — Marichka Chichkova`;
const summary=description||t(lang,'intro');
---
<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f5f1eb"/>
<meta name="description" content={summary}/>
<title>{fullTitle}</title>
{canonical&&<link rel="canonical" href={canonical}/>}
{canonical&&<link rel="alternate" hreflang={lang} href={canonical}/>}
{alternate&&<link rel="alternate" hreflang={lang==='en'?'uk':'en'} href={alternate}/>}
{english&&<link rel="alternate" hreflang="x-default" href={english}/>}
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Marichka Chichkova"/>
<meta property="og:locale" content={lang==='uk'?'uk_UA':'en_US'}/>
<meta property="og:title" content={fullTitle}/>
<meta property="og:description" content={summary}/>
{canonical&&<meta property="og:url" content={canonical}/>}
{shareImage&&<meta property="og:image" content={shareImage}/>}
{shareImage&&<meta property="og:image:width" content="1200"/>}
{shareImage&&<meta property="og:image:height" content="630"/>}
{shareImage&&<meta property="og:image:alt" content="Marichka Chichkova — Independent artist & cultural manager"/>}
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={summary}/>
{shareImage&&<meta name="twitter:image" content={shareImage}/>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<ClientRouter fallback="swap" />

</head>
<body>
<div id="project-transition-layer" transition:persist="project-transition-layer" aria-hidden="true"><img alt="" /></div>
<a class="skip-link" href="#content">{lang==='en'?'Skip to content':'Перейти до вмісту'}</a>
<header class="header"><div class="header-inner">
<div class="site-languages" aria-label={lang==='en'?'Language':'Мова'}>
<a href="/" hreflang="en" aria-current={lang==='en'?'page':undefined}>EN</a>
<span aria-hidden="true">/</span>
<a href={lang==='uk'?current:'/uk'+(current==='/'?'':current)} hreflang="uk" aria-current={lang==='uk'?'page':undefined}>UA</a>
</div>
<a class="wordmark" href={prefix+'/'}>Marichka Chichkova</a>
<nav class="navigation" aria-label={lang==='en'?'Main navigation':'Головна навігація'}>
{links.map(([key,url])=><a href={url} aria-current={current===url?'page':undefined}>{t(lang,key)}</a>)}
</nav></div></header>
<main id="content"><slot/></main>
<footer class="footer"><div class="wrap"><span>© {new Date().getFullYear()} Marichka Chichkova</span><span>Independent artist · Cultural manager · Lviv, Ukraine</span></div></footer>
<script is:inline>
(function(){
  if(!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const selector='.section .display, .section .large-copy, .project-card, .year-row, .about-narrative p, .about-cv, .cv-row, .detail-grid, .contact-links';
  const init=()=>{
    const items=Array.from(document.querySelectorAll(selector));
    if(!items.length)return;
    const observer=new IntersectionObserver((entries)=>{
      for(const entry of entries){
        if(entry.isIntersecting){
          entry.target.classList.add('scroll-revealed');
          observer.unobserve(entry.target);
        }
      }
    },{rootMargin:'0px 0px -45px 0px',threshold:0.06});
    for(const el of items){
      if(el.getBoundingClientRect().top < window.innerHeight-35)continue;
      el.classList.add('scroll-reveal');
      observer.observe(el);
    }
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
</script>
<script>
import { navigate } from 'astro:transitions/client';

type Phase = 'IDLE' | 'EXPANDING' | 'FULLSCREEN' | 'LOADING' | 'CONTRACTING' | 'COMPLETE';
declare global { interface Window { __chProjectTransition?: { phase: Phase; initialized?: boolean; scrollRestoration?: ScrollRestoration; wheelBlock?: (event: Event) => void; keyBlock?: (event: KeyboardEvent) => void } } }
const controller = window.__chProjectTransition ||= { phase: 'IDLE' as Phase };
let hiddenDestination: HTMLImageElement | null = null;
const layer = () => document.getElementById('project-transition-layer')!;
const frame = () => new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
const wait = (ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms));

function cleanup() {
  if (hiddenDestination) { hiddenDestination.style.visibility = ''; hiddenDestination = null; }
  const overlay = layer();
  overlay.getAnimations().forEach(animation => animation.cancel());
  overlay.style.cssText = '';
  overlay.classList.remove('is-active');
  overlay.querySelector('img')?.removeAttribute('src');
  if (controller.wheelBlock) {
    document.removeEventListener('wheel', controller.wheelBlock, true);
    document.removeEventListener('touchmove', controller.wheelBlock, true);
    controller.wheelBlock = undefined;
  }
  if (controller.keyBlock) {
    document.removeEventListener('keydown', controller.keyBlock, true);
    controller.keyBlock = undefined;
  }
  if (controller.scrollRestoration) {
    history.scrollRestoration = controller.scrollRestoration;
    controller.scrollRestoration = undefined;
  }
  controller.phase = 'IDLE';
}

if (!controller.initialized) {
controller.initialized = true;
document.addEventListener('click', async event => {
  if (controller.phase !== 'IDLE' || matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !Element.prototype.animate || event.defaultPrevented || event.button !== 0 ||
      event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
  const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-project-entry]') : null;
  if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
  const source = link.querySelector<HTMLImageElement>('.ch-work__photo');
  if (!source?.complete || !source.naturalWidth) return;

  event.preventDefault();
  event.stopImmediatePropagation();
  const overlay = layer();
  document.documentElement.appendChild(overlay);
  const image = overlay.querySelector('img')!;
  const slug = link.dataset.projectEntry!;
  const destinationUrl = link.href;
  const start = source.getBoundingClientRect();
  image.src = source.currentSrc || source.src;
  image.style.objectPosition = getComputedStyle(source).objectPosition;
  Object.assign(overlay.style, { position: 'fixed', zIndex: '9999', left: `${start.left}px`, top: `${start.top}px`, width: `${start.width}px`, height: `${start.height}px`, right: 'auto', bottom: 'auto', inset: 'auto', overflow: 'hidden' });
  overlay.classList.add('is-active');
  controller.wheelBlock = event => event.preventDefault();
  controller.keyBlock = event => { if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) event.preventDefault(); };
  document.addEventListener('wheel', controller.wheelBlock, { capture: true, passive: false });
  document.addEventListener('touchmove', controller.wheelBlock, { capture: true, passive: false });
  document.addEventListener('keydown', controller.keyBlock, true);
  controller.phase = 'EXPANDING';
  try {
    const expand = overlay.animate([
      { left: `${start.left}px`, top: `${start.top}px`, width: `${start.width}px`, height: `${start.height}px` },
      { left: '0px', top: '0px', width: `${innerWidth}px`, height: `${innerHeight}px` }
    ], { duration: 950, easing: 'cubic-bezier(.22,1,.36,1)' });
    await expand.finished;
    Object.assign(overlay.style, { left: '0px', top: '0px', width: `${innerWidth}px`, height: `${innerHeight}px` });
    expand.cancel();
    controller.phase = 'FULLSCREEN';
    const expandedAt = performance.now();
    await wait(300);
    controller.phase = 'LOADING';
    controller.scrollRestoration = history.scrollRestoration;
    history.scrollRestoration = 'manual';
    await navigate(destinationUrl);

    const destination = document.querySelector<HTMLElement>(`[data-project-image="${CSS.escape(slug)}"]`);
    const targetImage = destination?.querySelector('img');
    if (!destination || !targetImage) throw new Error('Project destination image is missing');
    // The moving clone is the ONLY visible photograph until its landing is complete.
    targetImage.style.visibility = 'hidden';
    hiddenDestination = targetImage;
    if (!targetImage.complete) await new Promise<void>((resolve, reject) => {
      targetImage.addEventListener('load', () => resolve(), { once: true });
      targetImage.addEventListener('error', () => reject(new Error('Project image failed to load')), { once: true });
    });
    await targetImage.decode();

    const y = Math.max(0, destination.getBoundingClientRect().top + scrollY - Math.min(100, innerHeight * .12));
    scrollTo(0, y);
    await frame();
    await frame();
    if (performance.now() - expandedAt < 300) await wait(300 - (performance.now() - expandedAt));
    const end = destination.getBoundingClientRect();
    controller.phase = 'CONTRACTING';
    const contract = overlay.animate([
      { left: '0px', top: '0px', width: `${innerWidth}px`, height: `${innerHeight}px` },
      { left: `${end.left}px`, top: `${end.top}px`, width: `${end.width}px`, height: `${end.height}px` }
    ], { duration: 1050, easing: 'cubic-bezier(.76,0,.24,1)' });
    await contract.finished;
    Object.assign(overlay.style, { left: `${end.left}px`, top: `${end.top}px`, width: `${end.width}px`, height: `${end.height}px` });
    contract.cancel();
    controller.phase = 'COMPLETE';
    // Swap visibility in the same frame; no second photograph during contraction.
    if (hiddenDestination) hiddenDestination.style.visibility = '';
    hiddenDestination = null;
    cleanup();
  } catch {
    cleanup();
    window.location.assign(destinationUrl);
  }
}, { capture: true });

window.addEventListener('pageshow', cleanup);
}
</script>
<style is:global>
#project-transition-layer{position:fixed;left:0;top:0;width:0;height:0;z-index:9999;pointer-events:auto;visibility:hidden;overflow:hidden;background:#111}
#project-transition-layer.is-active{visibility:visible}
#project-transition-layer img{display:block;width:100%;height:100%;object-fit:cover}
</style>
</body></html>
