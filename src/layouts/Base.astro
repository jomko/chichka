---
import '../styles/global.css';
import {t,base} from '../data/projects.js';
const {lang='en',title='Marichka Chichkova',description,alternate}=Astro.props;
const prefix=base(lang);
const current=Astro.url.pathname;
const switchHref=lang==='en'?'/uk'+(current==='/'?'':current):current.replace(/^\/uk/,'')||'/';
const links=[['projects',prefix+'/projects/'],['about',prefix+'/about/'],['contact',prefix+'/contact/']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f5f1eb"/><meta name="description" content={description||t(lang,'intro')}/><title>{title} — Marichka Chichkova</title><link rel="canonical" href={Astro.url.href}/><link rel="alternate" hreflang={lang==='en'?'uk':'en'} href={new URL(switchHref,Astro.url).href}/><link rel="alternate" hreflang={lang} href={Astro.url.href}/><link rel="alternate" hreflang="x-default" href={new URL(lang==='en'?current:switchHref,Astro.url).href}/></head><body><header class="header"><div class="wrap header-inner"><a class="wordmark" href={prefix+'/'}>Marichka Chichkova</a><nav class="navigation" aria-label="Primary navigation">{links.map(([key,url])=><a href={url} aria-current={current===url?'page':undefined}>{t(lang,key)}</a>)}<a class="language" href={switchHref} hreflang={lang==='en'?'uk':'en'}>{lang==='en'?'UA':'EN'}</a></nav></div></header><main><slot/></main><footer class="footer"><div class="wrap"><span>© {new Date().getFullYear()} Marichka Chichkova</span><span>Independent artist · Cultural manager · Lviv, Ukraine</span></div></footer></body></html>
