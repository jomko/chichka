---
import '../styles/global.css';
import '../styles/site-header.css';
import { ClientRouter } from 'astro:transitions';
import {t,base} from '../data/projects.js';
const {lang='en',title='Marichka Chichkova',description,image='/assets/social/og.png'}=Astro.props;
const prefix=base(lang);
const current=Astro.url.pathname;
const switchHref=lang==='en'?'/uk'+(current==='/'?'':current):current.replace(/^\/uk/,'')||'/';
const links=[['projects',prefix+'/projects/'],['about',prefix+'/about/'],['contact',prefix+'/contact/']];
const site=Astro.site; // Omit absolute SEO URLs rather than publish localhost canonicals.
const canonical=site ? new URL(current,site).href : null;
const alternate=site ? new URL(switchHref,site).href : null;
const enPath=lang==='en'?current:switchHref;
const english=site ? new URL(enPath,site).href : null;
const shareImage=site ? new URL(image,site).href : null;
const fullTitle=title==='Marichka Chichkova'?title:`${title} — Marichka Chichkova`;
const summary=description||t(lang,'intro');
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f5f1eb"/>
<meta name="description" content={summary}/>
<title>{fullTitle}</title>
{canonical&&<link rel="canonical" href={canonical}/>}
{canonical&&<link rel="alternate" hreflang={lang} href={canonical}/>}
{alternate&&<link rel="alternate" hreflang={lang==='en'?'uk':'en'} href={alternate}/>}
{english&&<link rel="alternate" hreflang="x-default" href={english}/>}
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Marichka Chichkova"/>
<meta property="og:locale" content={lang==='uk'?'uk_UA':'en_US'}/>
<meta property="og:title" content={fullTitle}/>
<meta property="og:description" content={summary}/>
{canonical&&<meta property="og:url" content={canonical}/>}
{shareImage&&<meta property="og:image" content={shareImage}/>}
{shareImage&&<meta property="og:image:width" content="1200"/>}
{shareImage&&<meta property="og:image:height" content="630"/>}
{shareImage&&<meta property="og:image:alt" content="Marichka Chichkova — Independent artist & cultural manager"/>}
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={summary}/>
{shareImage&&<meta name="twitter:image" content={shareImage}/>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<ClientRouter fallback="swap" />

</head>
<body>
<div id="project-transition-layer" transition:persist="project-transition-layer" aria-hidden="true"><img alt="" /></div>
<a class="skip-link" href="#content">{lang==='en'?'Skip to content':'Перейти до вмісту'}</a>
<header class="header"><div class="header-inner">
<div class="site-languages" aria-label={lang==='en'?'Language':'Мова'}>
<a href="/" hreflang="en" aria-current={lang==='en'?'page':undefined}>EN</a>
<span aria-hidden="true">/</span>
<a href={lang==='uk'?current:'/uk'+(current==='/'?'':current)} hreflang="uk" aria-current={lang==='uk'?'page':undefined}>UA</a>
</div>
<a class="wordmark" href={prefix+'/'}>Marichka Chichkova</a>
<nav class="navigation" aria-label={lang==='en'?'Main navigation':'Головна навігація'}>
{links.map(([key,url])=><a href={url} aria-current={current===url?'page':undefined}>{t(lang,key)}</a>)}
</nav></div></header>
<main id="content"><slot/></main>
<footer class="footer"><div class="wrap"><span>© {new Date().getFullYear()} Marichka Chichkova</span><span>Independent artist · Cultural manager · Lviv, Ukraine</span></div></footer>
<script is:inline>
(function(){
  if(!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const selector='.section .display, .section .large-copy, .project-card, .year-row, .about-narrative p, .about-cv, .cv-row, .detail-grid, .contact-links';
  const init=()=>{
    const items=Array.from(document.querySelectorAll(selector));
    if(!items.length)return;
    const observer=new IntersectionObserver((entries)=>{
      for(const entry of entries){
        if(entry.isIntersecting){
          entry.target.classList.add('scroll-revealed');
          observer.unobserve(entry.target);
        }
      }
    },{rootMargin:'0px 0px -45px 0px',threshold:0.06});
    for(const el of items){
      if(el.getBoundingClientRect().top < window.innerHeight-35)continue;
      el.classList.add('scroll-reveal');
      observer.observe(el);
    }
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
</script>
<script>
import { navigate } from 'astro:transitions';

const state = window.__chProjectTransitionState ||= {pending:null,initialized:false};
if (!state.initialized) {
state.initialized = true;
const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
function layer() { return document.getElementById('project-transition-layer'); }
function clear() {
 const el=layer();
 if(el){el.getAnimations().forEach(a=>a.cancel());el.style.cssText='';el.classList.remove('is-active');el.querySelector('img')?.removeAttribute('src');}
 state.pending=null;
}
document.addEventListener('click', async (event)=>{
 if(state.pending || reduce() || !Element.prototype.animate || event.defaultPrevented || event.button!==0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)return;
 const target=event.target instanceof Element ? event.target.closest('a[data-project-entry]') : null;
 if(!target || target.target==='_blank' || target.hasAttribute('download'))return;
 const photo=target.querySelector('.ch-work__photo');
 const el=layer();
 if(!photo || !photo.complete || !photo.naturalWidth || !el)return;
 event.preventDefault();
 const slug=target.dataset.projectEntry;
 const destination=target.href;
 const rect=photo.getBoundingClientRect();
 const moving=el.querySelector('img');
 moving.src=photo.currentSrc || photo.src;
 moving.style.objectPosition=getComputedStyle(photo).objectPosition;
 el.classList.add('is-active');
 Object.assign(el.style,{left:rect.left+'px',top:rect.top+'px',width:rect.width+'px',height:rect.height+'px'});
 state.pending={slug,destination,expandedAt:0};
 try {
  await el.animate([
   {left:rect.left+'px',top:rect.top+'px',width:rect.width+'px',height:rect.height+'px'},
   {left:'0px',top:'0px',width:innerWidth+'px',height:innerHeight+'px'}
  ],{duration:950,easing:'cubic-bezier(.22,1,.36,1)',fill:'forwards'}).finished;
  Object.assign(el.style,{left:'0px',top:'0px',width:'100vw',height:'100dvh'});
  el.getAnimations().forEach(a=>a.cancel());
  state.pending.expandedAt=performance.now();
  await navigate(destination);
 } catch (error) {
  clear();
  window.location.assign(destination);
 }
});
document.addEventListener('astro:page-load', async ()=>{
 if(!state.pending)return;
 const active=state.pending;
 const el=layer();
 const destination=document.querySelector('[data-project-image="'+CSS.escape(active.slug)+'"]');
 if(!el || !destination){clear();return;}
 const image=destination.querySelector('img');
 if(image && !image.complete){
   await Promise.race([
     new Promise(resolve=>{image.addEventListener('load',resolve,{once:true});image.addEventListener('error',resolve,{once:true})}),
     new Promise(resolve=>setTimeout(resolve,1500))
   ]);
 }
 // Make the landing photo visible, then settle the full-screen image into its exact box.
 const offset=Math.min(100,innerHeight*.12);
 const top=destination.getBoundingClientRect().top+scrollY-offset;
 scrollTo({top:Math.max(0,top),behavior:'instant'});
 await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
 // Hold the fully expanded image for at least 300 ms, even if the page is ready immediately.
 const hold=Math.max(0,300-(performance.now()-(active.expandedAt || performance.now())));
 if(hold)await new Promise(resolve=>setTimeout(resolve,hold));
 const rect=destination.getBoundingClientRect();
 try{
  await el.animate([
   {left:'0px',top:'0px',width:innerWidth+'px',height:innerHeight+'px'},
   {left:rect.left+'px',top:rect.top+'px',width:rect.width+'px',height:rect.height+'px'}
  ],{duration:1050,easing:'cubic-bezier(.76,0,.24,1)',fill:'forwards'}).finished;
 }catch{}
 clear();
});
document.addEventListener('astro:before-preparation',()=>{if(!state.pending)clear()});
addEventListener('pageshow',()=>{if(!state.pending)clear()});

}
</script>
<style is:global>
#project-transition-layer{position:fixed;left:0;top:0;width:0;height:0;z-index:9999;pointer-events:none;visibility:hidden;overflow:hidden;background:#111}
#project-transition-layer.is-active{visibility:visible}
#project-transition-layer img{display:block;width:100%;height:100%;object-fit:cover}
</style>
</body></html>
