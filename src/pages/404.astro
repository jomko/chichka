---
import Base from '../layouts/Base.astro';
import '../styles/not-found.css';
const uk=Astro.url.pathname.startsWith('/uk/');
const lang=uk?'uk':'en';
const home=uk?'/uk/':'/';
---
<Base lang={lang} title={uk?'Сторінку не знайдено':'Page not found'} description={uk?'Здається, ми збилися з ритму.':'We seem to have lost the rhythm.'}>
 <section class="ch-missing" aria-labelledby="missing-title">
   <h1 class="ch-missing__title" id="missing-title">{uk?'ЗБИЛИСЯ З РИТМУ.':'OFF THE BEAT.'}</h1>
  <a class="ch-missing__stage" href={home} aria-label={uk?'Повернутися на головну':'Return to homepage'} data-missing-stage>
   <span class="ch-missing__slices" aria-hidden="true">
    <span class="ch-missing__slice ch-missing__slice--one"><img src="/assets/chichka-404-portrait-large.webp" alt="" decoding="async" draggable="false" /></span>
    <span class="ch-missing__slice ch-missing__slice--two"><img src="/assets/chichka-404-portrait-large.webp" alt="" decoding="async" draggable="false" /></span>
    <span class="ch-missing__slice ch-missing__slice--three"><img src="/assets/chichka-404-portrait-large.webp" alt="" decoding="async" draggable="false" /></span>
   </span>
   <span class="ch-missing__stage-hint" aria-hidden="true">{uk?'НА ГОЛОВНУ ↗':'BACK TO HOME ↗'}</span>
  </a>
 </section>
 <script>import '../scripts/missing-page.ts';</script>
</Base>