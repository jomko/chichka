---
import Base from '../layouts/Base.astro';
import '../styles/not-found.css';
const uk=Astro.url.pathname.startsWith('/uk/');
const lang=uk?'uk':'en';
const home=uk?'/uk/':'/';
---
<Base lang={lang} title={uk?'Сторінку не знайдено':'Page not found'} description={uk?'Здається, ми збилися з ритму.':'We seem to have lost the rhythm.'}>
 <main class="ch-missing" aria-labelledby="missing-title">
  <h1 id="missing-title" class="ch-missing__sr">{uk?'Сторінку не знайдено':'Page not found'}</h1>
  <div class="ch-missing__masked" aria-hidden="true">404</div>
  <a class="ch-missing__back" href={home}>{uk?'НА ГОЛОВНУ':'BACK TO HOME'} <span aria-hidden="true">↗</span></a>
 </main>
 <script>import "../scripts/missing-mask.ts";</script>
</Base>