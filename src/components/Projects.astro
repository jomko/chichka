---
import Base from '../layouts/Base.astro';
import {projects,t,pathFor} from '../data/projects.js';
import '../styles/project-sections.css';
const {lang}=Astro.props as {lang:'en'|'uk'};
const uk=lang==='uk';
const images:Record<string,string>={
 'make-music-day-lviv':'/assets/fete.png',
 'spivmaisternia':'/spivmaisternia-wide.webp',
 'slavalachia':'/assets/slavalacha.png',
 'cycles':'/assets/cycles.png',
 'local-cultural-support':'/assets/lkp.png'
};
const groups=[
 {id:'artist',number:'01',name:uk?'Музика й виступи':'Music & Performance',photo:'/assets/m1.png',items:projects.filter(p=>p.type==='artist')},
 {id:'management',number:'02',name:uk?'Культурний менеджмент':'Cultural Management',photo:'/assets/m2.png',items:projects.filter(p=>p.type==='management')},
 {id:'voice',number:'03',name:uk?'Голосові практики й навчання':'Voice Practices & Teaching',photo:'/assets/m3.png',items:projects.filter(p=>p.slug==='spivmaisternia')}
];
---
<Base lang={lang} title={t(lang,'projects')}>
<div class="ch-projects" id="portfolio">
 <h1 class="ch-projects__visually-hidden">{uk?'Проєкти та практики':'Selected Projects'}</h1>
 {groups.map(group=><section class="ch-projects__chapter" id={group.id} aria-labelledby={`chapter-${group.id}`}>
   <figure class="ch-project-group__photo" data-project-image={`discipline-${group.id}`}>
     <img src={group.photo} alt="" loading="eager" decoding="async" width="1920" height="1080"/>
   </figure>
   <div class="ch-projects__chapter-heading"><span>{group.number} / 03</span><h2 id={`chapter-${group.id}`}>{group.name}</h2><span>{String(group.items.length).padStart(2,'0')} {uk?'ПРОЄКТІВ':'PROJECTS'}</span></div>
   <div class={"ch-projects__grid"+(group.id==='voice'?" ch-projects__grid--single":"")}>
     {group.items.map(p=><a class="ch-projects__card" href={pathFor(lang,p.slug)} data-project-entry={p.slug}>
       <figure class={p.slug==='local-cultural-support'?'ch-projects__card-photo ch-projects__card-photo--logo':'ch-projects__card-photo'}>
         {images[p.slug]||p.image?<img src={images[p.slug]||p.image} alt={p.name[lang]} loading="lazy" decoding="async"/>:<span class="ch-projects__placeholder">{p.name[lang]}</span>}
       </figure>
       <div class="ch-projects__card-title"><h3>{p.name[lang]}</h3><span aria-hidden="true">↗</span></div>
       <p class="ch-projects__role">{p.role[lang]}</p>
       <p class="ch-projects__description">{p.intro[lang]}</p>
       <span class="ch-projects__years">{p.years}</span>
     </a>)}
   </div>
 </section>)}
 <footer class="ch-projects__outro"><span>{uk?'СПІВПРАЦЯ':'COLLABORATION'}</span><a href={lang==='uk'?'/uk/contact/':'/contact/'}>{uk?'Маєте ідею?':'Have something in mind?'} <span aria-hidden="true">↗</span></a></footer>
</div>
</Base>