---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import {projects,t,base} from '../data/projects.js';
const {lang}=Astro.props;
const prefix=base(lang);
const selected=['spivmaisternia','make-music-day-lviv','slavalachia','nyzhnyj-zal','cycles','local-cultural-support'].map(slug=>projects.find(p=>p.slug===slug));
---
<Base lang={lang} title={lang==='en'?'Independent artist & cultural manager':'Незалежна мисткиня та культурна менеджерка'}>
<section class="wrap hero"><div><p class="micro">{t(lang,'tag')} · Lviv, Ukraine</p><h1>Marichka<br/>Chichkova</h1><p class="lead">{t(lang,'intro')}</p></div><figure><img src="/chichka.jpg" alt="Marichka Chichkova" fetchpriority="high"/></figure></section>
<section class="section"><div class="wrap intro-grid"><h2 class="display">{t(lang,'aboutHeading')}</h2><div><p class="large-copy">{t(lang,'aboutText')}</p><a class="text-link" href={prefix+'/about/'}>{t(lang,'about')} ↗</a></div></div></section>
<figure class="editorial-interlude editorial-interlude--after-about"><img src="/face_top.png" alt="" loading="lazy" decoding="async"/></figure>
<section class="section"><div class="wrap wrap--portfolio"><div class="eyebrow"><span class="micro">01 / {lang==='en'?'PORTFOLIO':'ПОРТФОЛІО'}</span><span class="micro">2026</span></div><h2 class="display">{t(lang,'selected')}</h2><p class="large-copy" style="max-width:650px">{t(lang,'selectedIntro')}</p><div class="project-grid">{selected.map(p=><ProjectCard p={p} lang={lang} showPhoto={['make-music-day-lviv','nyzhnyj-zal','local-cultural-support','cycles','slavalachia','spivmaisternia'].includes(p.slug)}/>)}</div><a class="text-link" href={prefix+'/projects/'}>{t(lang,'all')} ↗</a></div></section>
<figure class="editorial-interlude editorial-interlude--after-projects"><img src="/face_bottom.png" alt="" loading="lazy" decoding="async"/></figure>
<section class="section"><div class="wrap"><div class="eyebrow"><span class="micro">02 / {t(lang,'contact')}</span></div><h2 class="display">{t(lang,'contactHeading')}</h2><p class="large-copy">{t(lang,'contactText')}</p><a class="text-link" href={prefix+'/contact/'}>{t(lang,'contact')} ↗</a></div></section>
</Base>
