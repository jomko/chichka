---
import Base from '../layouts/Base.astro';
import {base,projects,pathFor} from '../data/projects.js';
import '../styles/home.css';
const {lang}=Astro.props as {lang:'en'|'uk'};
const prefix=base(lang);
const uk=lang==='uk';
const selectedSlugs=['make-music-day-lviv','spivmaisternia','slavalachia','cycles','local-cultural-support'];
const selected=selectedSlugs.flatMap(slug=>{const project=projects.find(p=>p.slug===slug);return project?[project]:[];});
const selectedImages:Record<string,string>={
 'make-music-day-lviv':'/assets/fete.png',
 'spivmaisternia':'/spivmaisternia-wide.webp',
 'slavalachia':'/assets/slavalacha.png',
 'cycles':'/assets/cycles.png',
 'local-cultural-support':'/assets/lkp.png'
};
const workLabel=(p:(typeof projects)[number])=>p.role[lang] || p.intro[lang];
const disciplines=[
 {title:uk?'Музика й виступи':'Music & Performance',desc:uk?'Традиційний спів · концерти · співпраця':'Traditional songs · concerts · collaborations',href:prefix+'/projects/#artist'},
 {title:uk?'Культурний менеджмент':'Cultural Management',desc:uk?'Фестивалі · резиденції · культурні проєкти':'Festivals · residencies · cultural projects',href:prefix+'/projects/#management'},
 {title:uk?'Голосові практики й навчання':'Voice Practices & Teaching',desc:uk?'Голос · майстерні · традиція':'Voice work · workshops · tradition',href:prefix+'/projects/#voice'}
];
---
<Base lang={lang} title={uk?'Музика, культура та співпраця':'Music, culture & collaboration'}>
<div class="ch-home">
 <div class="ch-hero-scene">
 <section class="ch-hero" aria-labelledby="ch-hero-title">
  <div class="ch-photo"><img src="/assets/marichka.png" alt={uk?"Портрет Марічки Чічкової":"Portrait of Marichka Chichkova"} fetchpriority="high" decoding="async" width="1664" height="934" /></div>
  <h1 class="ch-title" id="ch-hero-title">Marichka<br/>Chichkova</h1>
  <div class="ch-hero__bottom"><span class="ch-tag">{uk?'Мисткиня':'Artist'}<br/>{uk?'Культурна менеджерка':'Cultural manager'}<br/>{uk?'Практики голосу':'Voice practitioner'}</span><a class="ch-cta" href="#collaboration"><span class="ch-dot" aria-hidden="true">↗</span><span>{uk?'Створімо щось разом':'Let’s make something together'}</span></a></div>
 </section>
 </div>
 <section class="ch-disciplines" aria-label={uk?'Напрями діяльності':'Areas of practice'}>
 {disciplines.map((d,i)=><a class={'ch-discipline'+(i===1?' ch-discipline--management':'')} data-project-entry={`discipline-${['artist','management','voice'][i]}`} href={d.href}><span class="ch-number">0{i+1}</span><div class="ch-discipline__copy"><h2>{d.title}</h2></div><span class="ch-detail">{d.desc}<br/>↗</span><div class="ch-preview" aria-hidden="true"><img class="ch-work__photo" src={`/assets/m${i+1}.png`} alt="" loading="lazy" decoding="async" width="1920" height="1080" /></div></a>)}
 </section>
 <section class="ch-work" id="selected-work" aria-labelledby="ch-work-heading">
  <header class="ch-work__header">
   <div class="ch-work__eyebrow"><span>04 / {uk?'ВИБРАНЕ':'SELECTED'}</span><span>{uk?'Музика, люди, різні контексти.':'Music, people, different contexts.'}</span></div>
   <h2 id="ch-work-heading"><span>{uk?'ВИБРАНІ':'SELECTED'}</span> <em>{uk?'ПРОЄКТИ':'WORK'}</em><span class="ch-work__period" aria-hidden="true">●</span></h2>
   <a class="ch-work__all" href={prefix+'/projects/'}>{uk?'Усі проєкти':'All projects'} <span aria-hidden="true">↗</span></a>
  </header>
  <div class="ch-work__grid">
   {selected.map((p,i)=><a class={'ch-work__item ch-work__item--'+(i+1)} data-project-entry={p.slug} href={pathFor(lang,p.slug)} aria-label={p.name[lang]+': '+workLabel(p)}>
    <div class="ch-work__image">
     {selectedImages[p.slug] && <img class="ch-work__photo" src={selectedImages[p.slug]} alt={p.name[lang]} loading="lazy" decoding="async" />}
     <span class="ch-work__index">0{i+1}</span>
    </div>
    <div class="ch-work__caption">
     <div><h3>{p.name[lang]}</h3><p>{workLabel(p)}</p></div>
     <span class="ch-work__arrow" aria-hidden="true">↗</span>
    </div>
   </a>)}
   <div class="ch-work__statement" aria-label={uk?'Різні контексти, той самий намір':'Different contexts. Same intention.'}>
    <span>↗</span><p>{uk?'Різні контексти.':'Different contexts.'}<br/><em>{uk?'Спільний задум.':'Same intention.'}</em></p>
   </div>
  </div>
 </section>
 <section class="ch-about" id="about-preview" aria-labelledby="ch-about-title">
   <div class="ch-about__image"><img src="/assets/about.png" alt={uk?"Портрет Марічки Чічкової":"Portrait of Marichka Chichkova"} loading="lazy" decoding="async" width="1920" height="1080" /></div>
   <div class="ch-about__content">
    <p class="ch-about__label">05 / {uk?'ПРО МЕНЕ':'ABOUT'}</p>
    <h2 id="ch-about-title">{uk?'Цікавість зближує людей.':'Curiosity brings people together.'}</h2>
    <div class="ch-about__bottom">
     <p>{uk?'Я працюю з музикою, людьми й культурними середовищами. Співаю, викладаю та створюю простір для зустрічей — на сцені, у спільнотах і через спільну практику.':'I work with music, people and cultural spaces. I sing, teach, and create opportunities to meet — on stage, in communities and through shared practice.'}</p>
     <a href={prefix+'/about/'}>{uk?'Більше про мене':'More about me'} <span aria-hidden="true">↗</span></a>
    </div>
   </div>
  </section>
  <div class="ch-ending-scene"><section class="ch-collaboration" id="collaboration" aria-labelledby="ch-collab-title">
   <div class="ch-collaboration__meta"><span>06 / {uk?'СПІВПРАЦЯ':'COLLABORATION'}</span><span>LVIV · UKRAINE</span></div>
   <div class="ch-collaboration__center"><a class="ch-collaboration__disc" href={prefix+'/contact/'} aria-label={uk?'Перейти до контактів':'Go to contact page'}><span aria-hidden="true">↗</span></a><h2 id="ch-collab-title">{uk?'МАЄТЕ ЩОСЬ':'HAVE SOMETHING'}<br/>{uk?'НА ДУМЦІ?':'IN MIND?'}</h2><p>{uk?'Подивімось, що з цього може вийти.':'Let’s see what we can make of it.'}</p></div>
   <div class="ch-collaboration__footer">
    <div class="ch-collaboration__context">{uk?'Концерт · фестиваль · резиденція · майстерня · несподівана ідея':'Concert · festival · residency · workshop · unexpected idea'}</div>
    <div class="ch-collaboration__links"><a href="mailto:mari4i4ka@gmail.com">{uk?'Написати мені':'Email me'} <span aria-hidden="true">↗</span></a><a href="https://www.instagram.com/mari4i4ka/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
   </div>
   <a class="ch-collaboration__up" href="#top" aria-label={uk?'На початок сторінки':'Back to top'}><span aria-hidden="true">↑</span><span>{uk?'НАГОРУ':'BACK TO TOP'}</span></a>
  </section></div>
</div>

</Base>
