---
import Base from '../layouts/Base.astro';
import {t,base} from '../data/projects.js';
import '../styles/home.css';
const {lang}=Astro.props;
const prefix=base(lang);
const uk=lang==='uk';
const disciplines=[
 {title:uk?'Музика й виступи':'Music & Performance',desc:uk?'Традиційний спів · концерти · співпраця':'Traditional songs · concerts · collaborations',href:prefix+'/projects/#artist'},
 {title:uk?'Культурний менеджмент':'Cultural Management',desc:uk?'Фестивалі · резиденції · культурні проєкти':'Festivals · residencies · cultural projects',href:prefix+'/projects/#management'},
 {title:uk?'Голосові практики й навчання':'Voice Practices & Teaching',desc:uk?'Голос · майстерні · традиція':'Voice work · workshops · tradition',href:prefix+'/projects/spivmaisternia/'}
];
---
<Base lang={lang} title={uk?'Музика, культура та співпраця':'Music, culture & collaboration'}>
<div class="ch-home">
 <div class="ch-header-langs" aria-label={uk?'Мова':'Language'}><a href="/" aria-current={!uk?'page':undefined}>EN</a> &nbsp;/&nbsp; <a href="/uk/" aria-current={uk?'page':undefined}>UA</a></div>
 <section class="ch-hero" aria-labelledby="ch-hero-title">
  <div class="ch-photo" role="img" aria-label={uk?'Місце для фотографії Марічки':'Marichka portrait placeholder'}></div>
  <p class="ch-hero__top">{uk?'Мисткиня':'Artist'}<br/>{uk?'Культурна менеджерка':'Cultural manager'}<br/>{uk?'Практика голосу':'Voice practitioner'}</p>
  <h1 class="ch-title" id="ch-hero-title">Marichka<br/>Chichkova</h1>
  <div class="ch-hero__bottom"><span class="ch-tag">{uk?'Музика · Люди · Ідеї':'Music · People · Ideas'}<br/>{uk?'У русі':'In movement'}</span><a class="ch-cta" href="#collaboration"><span class="ch-dot" aria-hidden="true">↗</span><span>{uk?'Створімо щось разом':'Let’s make something together'}</span></a></div>
 </section>
 <section class="ch-disciplines" aria-label={uk?'Напрями діяльності':'Areas of practice'}>
 {disciplines.map((d,i)=><a class="ch-discipline" href={d.href}><span class="ch-number">0{i+1}</span><h2>{d.title}</h2><span class="ch-detail">{d.desc}<br/>↗</span><div class="ch-preview" aria-hidden="true"><span>IMAGE / {String(i+1).padStart(2,'0')}</span></div></a>)}
 </section>
 <section class="ch-placeholder" id="selected-work"><h2>{uk?'Вибрані проєкти':'Selected Work'}</h2><p>{uk?'Наступний етап: редакційна композиція реальних проєктів.':'Next phase: an editorial composition of real projects.'}</p><a href={prefix+'/projects/'}>{uk?'Дивитися проєкти':'Explore projects'} ↗</a></section>
 <section class="ch-placeholder" id="collaboration"><h2>{uk?'Маєте ідею?':'Have something in mind?'}</h2><p>{uk?'Розкажіть про неї.':'Let’s see what we can make of it.'}</p><a href={prefix+'/contact/'}>{uk?'Зв’язатися':'Get in touch'} ↗</a></section>
</div>
<script is:inline>
(()=>{
 const header=document.querySelector('.header');
 const title=document.getElementById('ch-hero-title');
 if(!header||!title)return;
 const observer=new IntersectionObserver(entries=>header.classList.toggle('is-scrolled',!entries[0].isIntersecting),{rootMargin:'-80px 0px 0px 0px',threshold:0});
 observer.observe(title);
})();
</script>
</Base>