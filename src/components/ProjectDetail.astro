---
import Base from '../layouts/Base.astro';
import {projects,t,base,pathFor} from '../data/projects.js';
import '../styles/project-detail.css';
const {p,lang}=Astro.props as {p:(typeof projects)[number];lang:'en'|'uk'};
const idx=projects.findIndex(item=>item.slug===p.slug);
const next=projects[(idx+1)%projects.length];
const uk=lang==='uk';
const images:Record<string,string>={
 'make-music-day-lviv':'/assets/fete.webp',
 'spivmaisternia':'/assets/spivmaisternia-wide.webp',
 'slavalachia':'/assets/slavalacha.webp',
 'cycles':'/assets/cycles.webp',
 'local-cultural-support':'/assets/lkp.webp'
};
const image=images[p.slug] || p.image;
---
<Base lang={lang} title={p.name[lang]} description={p.intro[lang]}>
<article class="ch-project">
 <div class="ch-project__intro">
  <div class="ch-project__meta"><a href={base(lang)+'/projects/'}>← {uk?'УСІ ПРОЄКТИ':'ALL PROJECTS'}</a><span>{p.type==='management'?(uk?'КУЛЬТУРНИЙ МЕНЕДЖМЕНТ':'CULTURAL MANAGEMENT'):(uk?'МИСТЕЦЬКА ПРАКТИКА':'ARTISTIC PRACTICE')}</span></div>
  <h1>{p.name[lang]}</h1>
  <div class="ch-project__lead"><span>{p.years}</span><p>{p.intro[lang]}</p></div>
 </div>
 {image && <figure class="ch-project__hero" data-project-image={p.slug}><img src={image} alt={p.name[lang]} loading="eager" decoding="async" fetchpriority="high"/></figure>}
 <section class="ch-project__story" aria-label={uk?'Про проєкт':'About the project'}>
  <div class="ch-project__facts">
   <span class="ch-project__serial">01 / {uk?'КОНТЕКСТ':'CONTEXT'}</span>
   {p.years&&<div class="ch-project__fact"><span>{t(lang,'years')}</span><strong>{p.years}</strong></div>}
   {p.role?.[lang]&&<div class="ch-project__fact"><span>{t(lang,'role')}</span><strong>{p.role[lang]}</strong></div>}
  </div>
  <div class="ch-project__body">
   {p.body[lang].split(/\n\s*\n/).map((paragraph:string)=><p>{paragraph}</p>)}
   {p.links.length>0&&<div class="ch-project__links"><span>{t(lang,'documentation')}</span>{p.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
  </div>
 </section>
 {p.videoId&&<section class="ch-project__video" aria-label={uk?'Відео проєкту':'Project video'}>
  <div class="ch-project__video-inner">
   <span class="ch-project__video-label">{uk?'ДИВИТИСЬ':'WATCH'} / {p.name[lang]}</span>
   <div class="ch-project__video-frame">
    <iframe src={`https://www.youtube-nocookie.com/embed/${p.videoId}`} title={`${p.name[lang]} — ${uk?'відео':'video'}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
   </div>
  </div>
 </section>}
 <a class="ch-project__next" href={pathFor(lang,next.slug)}><span>02 / {uk?'НАСТУПНИЙ ПРОЄКТ':'NEXT PROJECT'}</span><strong>{next.name[lang]}</strong><span class="ch-project__next-arrow" aria-hidden="true">↗</span></a>
</article>
</Base>
