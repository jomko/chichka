---
import Base from '../layouts/Base.astro';
import {projects,t,base,pathFor} from '../data/projects.js';
const {p,lang}=Astro.props;
const idx=projects.findIndex(item=>item.slug===p.slug);
const next=projects[(idx+1)%projects.length];
---
<Base lang={lang} title={p.name[lang]} description={p.intro[lang]}>
<section class="wrap page-head"><a class="micro" href={base(lang)+'/projects/'}>← {t(lang,'back')}</a><h1>{p.name[lang]}.</h1><p class="large-copy">{p.intro[lang]}</p></section>
{p.image?<figure class="detail-hero"><img src={p.image} alt={p.name[lang]}/></figure>:<div class="detail-hero" style="display:flex;align-items:center;justify-content:center"><span class="display">{p.name[lang]}</span></div>}
<section class="section"><div class="wrap detail-grid"><div>{p.years&&<div class="meta-row"><span class="micro">{t(lang,'years')}</span><strong>{p.years}</strong></div>}{p.role?.[lang]&&<div class="meta-row"><span class="micro">{t(lang,'role')}</span><strong>{p.role[lang]}</strong></div>}</div><div class="detail-body">{p.body[lang].split(/\n\s*\n/).map(paragraph=><p>{paragraph}</p>)}{p.links.length>0&&<div class="links-list"><span class="micro">{t(lang,'documentation')}</span>{p.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}<p class="note" style="font-size:12px;margin-top:55px">{t(lang,'sourceNote')}</p></div></div></section>
{p.landscapeImage&&<figure class="residency-landscape"><img src={p.landscapeImage} alt={lang==='uk'?'Вид на річку з Андрутова':'River view from Andrutiv'} loading="lazy" decoding="async"/></figure>}
<section class="section"><div class="wrap"><span class="micro">{t(lang,'next')}</span><h2 class="display" style="margin-top:22px"><a href={pathFor(lang,next.slug)}>{next.name[lang]} ↗</a></h2></div></section></Base>
