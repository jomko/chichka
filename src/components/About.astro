---
import Base from '../layouts/Base.astro';
import {t} from '../data/projects.js';
const {lang}=Astro.props;
---
<Base lang={lang} title={t(lang,'about')}><section class="wrap page-head"><p class="micro">About / Marichka Chichkova</p><h1>{t(lang,'aboutHeading')}</h1></section><figure class="detail-hero"><img src="/about.png" alt="Marichka Chichkova"/></figure><section class="section"><div class="wrap intro-grid"><h2 class="display">{t(lang,'about')}</h2><div><p class="large-copy">{t(lang,'aboutText')}</p><p class="prose">{t(lang,'aboutMore')}</p><p class="note">{t(lang,'sourceNote')}</p></div></div></section></Base>
