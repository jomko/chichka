---
import Base from '../layouts/Base.astro';
import {projects,base,pathFor} from '../data/projects.js';
const {lang='en'}=Astro.props;
const uk=lang==='uk';
const prefix=base(lang);
const story=uk?[
  "Я музикантка й культурна менеджерка зі Львова. Уже понад десять років моє життя пов’язане з українською традиційною музикою — але найцікавіше починається тоді, коли вона зустрічається з іншими людьми, сценами й ідеями.",
  "Я співаю, граю на концертині та віолончелі, аранжую музику й працюю зі звуком у театрі. Виступала з Olenky та Torbán, співпрацюю з музикантами з інших країн у Slavalachia, створювала музику й брала участь у театральних та аудіовізуальних роботах, зокрема CYCLES, «Вертеп» і «Коло».",
  "У 2020 році я заснувала Співмайстерню — свою школу українського традиційного співу. Для мене це не лише уроки: це нагода слухати одне одного, співати разом і знаходити для старих пісень місце в сьогоденні.",
  "І я люблю не тільки виходити на сцену, а й робити так, щоб сцена взагалі з’явилася. Керую Святом музики у Львові, працюю з незалежним простором Нижній Зал та культурними ініціативами ГО «Локальна культурна підтримка». Це різні масштаби роботи — від камерної зустрічі до фестивалю, що охоплює місто.",
  "Мені цікаві люди, які готові пробувати нове: музиканти, режисери, куратори, команди фестивалів. Іноді найкращі проєкти починаються просто з розмови."
]:[
  "I'm a musician and cultural manager based in Lviv, Ukraine. For more than a decade, Ukrainian traditional music has been at the heart of what I do — but the most exciting things happen when it meets new people, stages and ideas.",
  "I sing, play concertina and cello, arrange music and work with sound in theatre. I've performed with Olenky and Torbán, collaborated internationally through Slavalachia, and worked on theatre and audiovisual productions including CYCLES, Vertep and Kolo. Sometimes I'm performing; sometimes I'm creating the music behind the performance.",
  "In 2020, I founded Spivmaisternia, my own school of Ukrainian traditional singing. It's about more than lessons. It's a place to listen to one another, sing together and find a place for old songs in the present.",
  "I also love making the stage possible in the first place. I direct Make Music Day Lviv, work with the independent venue Nyzhnyj Zal and help bring cultural initiatives to life through Local Cultural Support. That can mean anything from an intimate gathering to a festival spread across a city.",
  "I'm always interested in people who want to try something new — musicians, theatre-makers, curators and festival teams. Some of the best projects start with a conversation."
];
const entries=[
 {year:'2023',items:[['kolo','Kolo'],['','Lesya. Herstory']]},
 {year:'2022',items:[['vertep','Vertep'],['zriz','ZRIZ'],['','Where is Home']]},
 {year:'2021',items:[['cycles','CYCLES'],['nyzhnyj-zal','Nyzhnyj Zal']]},
 {year:'2020',items:[['spivmaisternia','Spivmaisternia'],['we-selo','We_selo']]},
 {year:'2019',items:[['slavalachia','Slavalachia']]},
 {year:'2017',items:[['torban','Torbán']]},
 {year:'2014',items:[['olenky','Olenky']]},
 {year:'2012',items:[['make-music-day-lviv',uk?'Свято музики у Львові':'Make Music Day Lviv']]}
];
const label=(slug,name)=>{const p=projects.find(x=>x.slug===slug);return p?.name[lang]||name};
---
<Base lang={lang} title={uk?'Про Марічку':'About'}>
<section class="wrap about-opening"><p class="micro">{uk?'Про Марічку / Львів, Україна':'About / Lviv, Ukraine'}</p><h1>{uk?'Марічка Чічкова':'Marichka Chichkova'}</h1><p class="about-deck">{uk?'Незалежна мисткиня та культурна менеджерка.':'Independent artist & cultural manager.'}</p></section>
<figure class="about-portrait"><img src="/assets/images/about.png" alt="Marichka Chichkova" /></figure>
<section class="section"><div class="wrap about-story"><div><span class="micro">01 / {uk?'Історія':'Story'}</span><h2 class="display">{uk?'Музика — це початок. Далі цікавіше.':'Music is just the beginning.'}</h2></div><div class="about-narrative">{story.map((line,i)=><p class={i===0?'about-first':undefined}>{line}</p>)}</div></div></section>
<section class="section"><div class="wrap"><div class="eyebrow"><span class="micro">02 / {uk?'Вибрана хронологія':'Selected chronology'}</span><span class="micro">2012—2023</span></div><h2 class="display">{uk?'Роботи за роками':'Work through the years'}</h2><p class="about-chronology-intro">{uk?'Деякі проєкти почалися давно й тривають досі. Тут — вибрані роботи та ролі, а повніший перелік є у CV.':'Some of these projects began years ago and are still growing. Here is a selection of work and roles; the CV has a fuller record.'}</p><div class="year-list">{entries.map(e=><div class="year-row"><span class="year">{e.year}</span><div class="year-items">{e.items.map(([slug,name])=>slug?<a href={pathFor(lang,slug)}>{label(slug,name)} <span aria-hidden="true">↗</span></a>:<span>{name}</span>)}</div></div>)}</div></div></section>
<section class="section"><div class="wrap about-cv"><div><span class="micro">03 / Curriculum vitae</span><h2 class="display">{uk?'Професійний досвід':'Full professional record'}</h2><p>{uk?'Фестивалі, гурти, музика для театру, культурний менеджмент та освіта — детальніша хронологія моєї роботи.':'Festivals, bands, theatre music, cultural management and training — a more detailed view of the work I’ve done.'}</p></div><a class="cv-link" href={prefix+'/cv/'}>{uk?'Переглянути CV':'View CV'} <span>↗</span></a></div></section>
</Base>
